/target
**/*.rs.bk
Cargo.lock.orig
gpui-component
.venv/

# Session-local hook scratch (remember plugin); not project state.
.remember/

# A project's own Hadron workspace: the user's team, their field, their
# repo-specific rules. This one (ours) is a live workspace, not source we ship —
# publishing it would show the world our bus, not our app.
#
# The rules Hadron *ships* with are NOT here. The Standard Model is compiled into
# the binary from crates/hadron-gluon/invariants/, so it is handed to every quark
# on every turn without depending on any file surviving a clone.
.hadron/

# Claude Code local state (incl. embedded worktrees)
.claude/
.remember/
.superpowers/

# Screenshot and recording files
assets/screenshots/

# Python bytecode from the Antigravity SDK adapter (crates/hadron-gluon/scripts/)
__pycache__/
*.pyc
